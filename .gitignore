# 本地密钥与运行环境（含真实 API Key，绝不入库）
.env

# Python 运行产物
__pycache__/
*.py[cod]
.pytest_cache/

# 临时脚本与清库备份快照
_tmp_*
data/kb_backup_*.json

# 向量库持久化数据：本地 Chroma 文件里含文档原文与向量，不入库。
# 需要重建时用 python run_eval.py（或上传接口）——chunk_id 是内容哈希，重跑结果一致。
data/chroma_db/
