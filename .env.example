# ============================================================================
#  RAG 知识库问答系统 - 环境变量配置模板
#  复制此文件为 .env 并填写实际值:
#    cp .env.example .env
# ============================================================================

# 运行环境: development / production
ENV=development

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 通义千问 API
QWEN_API_KEY=your-qwen-api-key

# Ollama 本地模型
OLLAMA_HOST=http://localhost:11434

# Qdrant (生产环境)
QDRANT_HOST=localhost
QDRANT_PORT=6333
