# ============================================================================
#  RAG 知识库问答系统 - 环境变量配置模板
#  复制此文件为 .env 并填写实际值:
#    cp .env.example .env
# ============================================================================

# 运行环境: development / production
ENV=development

# 向量库类型: chroma (默认, 本地持久化) / pgvector (需外部 PostgreSQL)
STORE_TYPE=chroma

# ---- PGvector 连接 (PostgreSQL + 纯 SQL 向量兼容层) ----
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=rag_kb
PG_USER=rag
PG_PASSWORD=rag123

# ---- LLM API Key (至少配置一个) ----
# 当前使用哪个大模型: deepseek / qwen / ollama（默认 qwen）
# ACTIVE_LLM=qwen

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 通义千问 API
QWEN_API_KEY=your-qwen-api-key

# Ollama 本地模型
OLLAMA_HOST=http://localhost:11434

# ---- HuggingFace 模型 ----
# 在线模式：使用镜像加速下载
HF_ENDPOINT=https://hf-mirror.com
# 离线模式：模型已缓存到本地时启用（设为 1）
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ---- OCR 识别（PDF 图片/扫描件，可选）----
# 全局开启后所有上传的 PDF 自动 OCR；也可在 Web 端上传时按文件勾选
# 需先安装: pip install rapidocr PyMuPDF
# OCR_ENABLE=1

# ---- 检索性能调优（可选）----
# CPU 推理线程数，0 = 自动取逻辑核数（上限 16）
# TORCH_THREADS=0
# 精排候选上限：CPU 上每条约 1.9 秒，这是响应速度的主开关
# RERANK_MAX_CANDIDATES=6
# 精排单条最大 token 数（降到 256 会打乱 Top3 排序并压低分数，不建议）
# RERANK_MAX_LENGTH=512
# 精排可信门槛（sigmoid 尺度）：最高分低于它就走 Web 兜底，不给来源保底
# RERANK_MIN_SCORE=0.5

